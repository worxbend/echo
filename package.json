{
  "name": "echo-microsite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Build-time tooling only; Echo's published microsite has no runtime dependencies.",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/site-infra.test.mjs",
    "build:site": "node scripts/site-build.mjs && node scripts/site-check.mjs",
    "check:site": "node scripts/site-check.mjs",
    "serve:site": "node scripts/site-server.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "parse5": "8.0.1",
    "postcss": "8.5.30",
    "postcss-value-parser": "4.2.0"
  }
}
